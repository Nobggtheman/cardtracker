# PostgreSQL connection
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cardtracker

PORT=3001

# Price data source: "mock" (fake prices for development) or "cardapi".
# Defaults to "cardapi" when CARD_API_KEY is set, otherwise "mock".
PRICE_PROVIDER=
CARD_API_BASE_URL=https://thecardapi.com/api/v1/market
CARD_API_KEY=
# Recent sales fetched per card. Each sale counts against the plan's daily row limit.
CARD_API_SALES_LIMIT=10

# How often to check prices, in minutes (0 disables the schedule)
PRICE_CHECK_INTERVAL_MINUTES=1440

# Alert when a card is up this many percent over its lowest price in the window
ALERT_THRESHOLD_PCT=25
ALERT_WINDOW_DAYS=7

# Browser push keys - generate with: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
