{
  "name": "cardtracker",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "db:init": "npm run db:init -w server",
    "vapid": "npm run vapid -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
